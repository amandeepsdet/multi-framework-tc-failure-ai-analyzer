# Template for local secrets. Copy to `.env` and fill in real values.
# `.env` is gitignored; this template is safe to commit.
#
# The AIQA SDK runs fully offline by default and needs NONE of these. Only set a
# provider key below if you opt in to LLM-powered analysis.

# =====================================================================
# AI Failure Analysis Engine (all OPTIONAL — defaults keep it fully OFF
# and offline; the framework runs unchanged with none of these set).
# =====================================================================
# Master switch. Leave false for the classic PASS/FAIL behaviour.
# AI_ENABLED=false

# Provider: heuristic (default, offline) | openai | azure | claude | gemini | ollama
# AI_PROVIDER=heuristic
# AI_MODEL=gpt-4o-mini
# AI_TEMPERATURE=0.1
# AI_MAX_TOKENS=1200

# Provider credentials (only for the provider you choose; never committed).
# AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# OLLAMA_HOST=http://localhost:11434

# Vision (LLM screenshot analysis) — requires a vision-capable provider.
# AI_VISION_ENABLED=false

# Embeddings + vector store for RAG similarity search.
# AI_EMBEDDING_PROVIDER=hash        # hash (offline) | openai
# AI_VECTOR_BACKEND=json            # json (offline) | chroma
# AI_RAG_TOP_K=5

# Security: mask secrets before sending anything to an LLM.
# AI_MASK_SECRETS=true
# AI_MASK_URLS=false
