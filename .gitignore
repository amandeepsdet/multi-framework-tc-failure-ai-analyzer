# Python / virtual env
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — never commit real credentials
.env

# Generated artifacts
logs/
reports/
screenshots/
test-results/

# Coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Committed sample output (a showcase of what the SDK produces) — keep it
# despite the generic reports/ rule above.
!sample_output/
!sample_output/**

# AI engine runtime output (keep the folders via .gitkeep, ignore contents)
failure_history/*
!failure_history/.gitkeep
ai_reports/*
!ai_reports/.gitkeep
vector_db/*
!vector_db/.gitkeep

# Local zip artifacts
*.zip
make_zip*.ps1

# Python packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Local scratch / assets not part of the package
upload.png
sample_output/
